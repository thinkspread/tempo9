@PACKAGE_INIT@

set(Tempo9LLM_PREFIX "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(Tempo9EngineABI 1.4 CONFIG REQUIRED)
find_dependency(Threads REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/Tempo9LLMTargets.cmake")

set(Tempo9LLM_VERSION "@TEMPO9_LLM_PACKAGE_VERSION@")
set_and_check(Tempo9LLM_RUNTIME_MANIFEST
              "${Tempo9LLM_PREFIX}/@CMAKE_INSTALL_DATADIR@/tempo9/Tempo9LLMRuntimeManifest.json")
check_required_components(Tempo9LLM)
